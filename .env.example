# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so it must never hold a real value.

# ---------------------------------------------------------------------------
# Development database — what the app and the tests use.
#
# Both lines address the same database and differ only in port. The difference
# matters: the app needs the transaction pooler, drizzle-kit needs a real
# session because DDL cannot run on the transaction pooler.
#
# Supabase dashboard → Connect → Connection string.
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Production database — for running migrations from a laptop, and nothing else.
#
# The deployed app never reads these. It reads DATABASE_URL, which Vercel sets
# per environment: Production from grains-prod, Preview and Development from
# grains-dev. Setting a production URL here does not affect any deployment.
#
# DATABASE_URL_PROD is unused today; it is here so the pair stays together and
# so a future task that needs a production read has an obvious place to look.
# Only DIRECT_URL_PROD is read, by `pnpm db:migrate:prod`.
# ---------------------------------------------------------------------------

DATABASE_URL_PROD=""
DIRECT_URL_PROD=""

# ---------------------------------------------------------------------------
# Auth.js v5 — Google sign-in (Ticket 2).
#
# The names are Auth.js conventions, not ours: it auto-discovers
# AUTH_<PROVIDER>_ID and AUTH_<PROVIDER>_SECRET, so the Google provider needs
# no explicit configuration.
#
#   AUTH_GOOGLE_ID      OAuth 2.0 client ID      \
#   AUTH_GOOGLE_SECRET  OAuth 2.0 client secret  / Google Cloud → Credentials
#   AUTH_SECRET         session signing key      openssl rand -base64 32
#
# Authorised redirect URI for the client:
#   http://localhost:3000/api/auth/callback/google
#   https://<production-domain>/api/auth/callback/google
# ---------------------------------------------------------------------------

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Cloudflare R2 — DEVELOPMENT bucket (Track C, C1).
#
# What this machine reads. Set up by hand once per environment; the steps are in
# docs/plans/r2-setup.md.
#
# WRITES — server-only. Never prefixed NEXT_PUBLIC_, never sent to a browser:
# together these are write access to the bucket.
#
# R2_ACCOUNT_ID has no _PROD twin below because there is one Cloudflare account
# holding both buckets. It is also what the S3 endpoint is derived from
# (https://<account-id>.r2.cloudflarestorage.com).
#
# R2_BUCKET is needed even though the public URL never mentions it: the custom
# domain is bound to one bucket for *reads*, but the S3 API this uploads through
# addresses buckets by name.
# ---------------------------------------------------------------------------

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="grains-photos-dev"

# ---------------------------------------------------------------------------
# READS — public by necessity, not by oversight.
#
# NEXT_PUBLIC_ because next/image's custom loader (P23) runs in the browser: it
# builds /cdn-cgi/image/width=…/<key> URLs during render on both sides, so a
# server-only variable would be undefined exactly where the src is written.
# Nothing is leaked by this — the value already appears in the src of every
# image on every page.
#
# One custom domain per bucket, because a domain binds to exactly one. The
# production name is the plain one; development takes the prefixed one.
#
# No trailing slash and no bucket name: the domain is bound to the bucket, so a
# key of photos/abc.jpg is served at <url>/photos/abc.jpg.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_R2_PUBLIC_URL="https://images-dev.<your-domain>"

# ---------------------------------------------------------------------------
# Cloudflare R2 — PRODUCTION bucket.
#
# The deployed app never reads the _PROD names. It reads the plain ones above,
# which Vercel sets per environment — exactly as it does for DATABASE_URL. So
# the Production environment on Vercel must carry:
#
#   R2_BUCKET                  grains-photos-prod
#   NEXT_PUBLIC_R2_PUBLIC_URL  https://images.<your-domain>
#   R2_ACCESS_KEY_ID           from a token scoped to the prod bucket
#   R2_SECRET_ACCESS_KEY       "
#   R2_ACCOUNT_ID              the same account id as above
#
# ⚠ THE ONE THAT BITES: if Vercel's Production environment does not override
# R2_BUCKET, production uploads land in the development bucket and nothing
# errors — the credentials are valid, the bucket exists, the write succeeds.
# It surfaces later as production photos that 404 behind the production domain.
# Check this at launch the way the region is checked, not by assuming it.
#
# The two secrets below are for a laptop script that has to touch production
# storage. Nothing reads them today, and they are here for the same reason
# DATABASE_URL_PROD is: so the pair stays together and a future task has an
# obvious place to look. If such a script is ever written it gets the same
# confirmation-token treatment as `pnpm db:migrate:prod`, because the failure
# mode — deleting the wrong bucket's objects — is worse than a bad migration.
# ---------------------------------------------------------------------------

R2_BUCKET_PROD="grains-photos-prod"
R2_ACCESS_KEY_ID_PROD=""
R2_SECRET_ACCESS_KEY_PROD=""
