# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so it must never hold a real value.

# ---------------------------------------------------------------------------
# Development database — what the app and the tests use.
#
# Both lines address the same database and differ only in port. The difference
# matters: the app needs the transaction pooler, drizzle-kit needs a real
# session because DDL cannot run on the transaction pooler.
#
# Supabase dashboard → Connect → Connection string.
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Production database — for running migrations from a laptop, and nothing else.
#
# The deployed app never reads these. It reads DATABASE_URL, which Vercel sets
# per environment: Production from grains-prod, Preview and Development from
# grains-dev. Setting a production URL here does not affect any deployment.
#
# DATABASE_URL_PROD is unused today; it is here so the pair stays together and
# so a future task that needs a production read has an obvious place to look.
# Only DIRECT_URL_PROD is read, by `pnpm db:migrate:prod`.
# ---------------------------------------------------------------------------

DATABASE_URL_PROD=""
DIRECT_URL_PROD=""

# ---------------------------------------------------------------------------
# Auth.js v5 — Google sign-in (Ticket 2).
#
# The names are Auth.js conventions, not ours: it auto-discovers
# AUTH_<PROVIDER>_ID and AUTH_<PROVIDER>_SECRET, so the Google provider needs
# no explicit configuration.
#
#   AUTH_GOOGLE_ID      OAuth 2.0 client ID      \
#   AUTH_GOOGLE_SECRET  OAuth 2.0 client secret  / Google Cloud → Credentials
#   AUTH_SECRET         session signing key      openssl rand -base64 32
#
# Authorised redirect URI for the client:
#   http://localhost:3000/api/auth/callback/google
#   https://<production-domain>/api/auth/callback/google
# ---------------------------------------------------------------------------

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Supabase Storage — optional until the photos bucket exists (Track C, C1).
#
# Only the project URL, and only so lab pages can build public object URLs for
# atmosphere photos: the bucket is public-read, so the object path is the CDN
# path. Leave it blank and lab pages omit their photo section instead of
# rendering broken images.
#
# SUPERSEDED. Object storage moved to Cloudflare R2 on 2026-09-08 (00_BACKLOG,
# "Object storage: R2, not Supabase"), so the URL shape this builds is wrong.
# It stays blank and unread until Track C deletes lib/labs/photo-url.ts with it.
# ---------------------------------------------------------------------------

SUPABASE_URL=""

# ---------------------------------------------------------------------------
# Cloudflare R2 — object storage for photos.
#
# Set up by hand once per environment; the steps are in
# docs/plans/r2-setup.md. The first three are server-only credentials and must
# never be prefixed NEXT_PUBLIC_ or reach a browser: they are write access to
# the bucket. R2_PUBLIC_URL is not a secret — it is the custom domain readers
# already fetch images from.
#
# R2_PUBLIC_URL takes no trailing slash and no bucket name: the domain is bound
# to the bucket, so a key of photos/abc.jpg is served at <url>/photos/abc.jpg.
# ---------------------------------------------------------------------------

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL=""
